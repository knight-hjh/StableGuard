# Placeholders only. Do not commit a populated .env file.
# Historical names are retained for OpenAI-compatible backends.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.example.invalid/v1
SILICONFLOW_MODEL=replace-with-exact-provider-model-id

# Run from the repository root. Inputs are under dataset/projects/<project>/.
JOBS=1
SCAN_OUT=logs/legacy-scan
SCAN_PARSE_TIMEOUT=420
ABLATION_MODE=full
NO_INLINE=0
RUN_CROSS=0

# Optional subtype restriction; empty means all registered detectors.
SUBS=

# Set only parameters supported by the chosen provider.
# SILICONFLOW_ENABLE_THINKING=false
# SILICONFLOW_THINKING_BUDGET=4096
# DEEPSEEK_THINKING_TYPE=disabled
# DEEPSEEK_REASONING_EFFORT=low

# Optional local compiler/build controls.
# SOLC_VERSION=0.8.20
# SG_IGNORE_COMPILE=ExampleProtocol
# PROJECT_LIST=logs/projects.txt

# Packaged project list; JSON labels are never sent to the scanner.
PROJECT_LIST=dataset/project-list.txt
